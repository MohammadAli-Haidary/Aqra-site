# Environment Configuration for Egra Bookstore Backend
# کتاب‌فروشی اقرأ - تنظیمات سرور

# Port
PORT=5000

# JWT Secret (change this in production!)
JWT_SECRET=egra-bookstore-secret-key-change-in-production-2024

# Admin default credentials (change after first login!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Database
DB_PATH=./database/egra.db

# Upload settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
